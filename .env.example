# Required: your Mintsoft API key (Settings > API in Mintsoft). NEVER commit the real .env.
MINTSOFT_API_KEY=

# Writes are OFF by default. Set to 1 to register the 8 write tools.
MINTSOFT_ENABLE_WRITES=0

# Comma-separated ClientIds writes are permitted against. Default EMPTY = every
# write refused. Mintsoft has NO sandbox — allowlist only a client you can afford
# to change (e.g. a dedicated test client account).
MINTSOFT_WRITE_CLIENT_ALLOWLIST=

# Audit log location (default: ~/.mintsoft-mcp/mintsoft_api_audit.jsonl)
#MINTSOFT_AUDIT_LOG=
# Set to 0 to disable audit logging entirely (not recommended)
#MINTSOFT_AUDIT=1
# Set to 1 to log only writes (skip GET reads)
#MINTSOFT_AUDIT_WRITES_ONLY=0

# Optional: fetch the key from GCP Secret Manager instead of MINTSOFT_API_KEY
#MINTSOFT_SECRET_PROJECT=
#MINTSOFT_SECRET_NAME=mintsoft-api-key

# Optional: explicit target for the smoke test's --write demo
#MINTSOFT_TEST_CLIENT_ID=
